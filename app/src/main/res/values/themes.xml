<resources>
    <style name="Theme.UsbBoost" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lime</item>
        <item name="colorOnPrimary">@color/text_on_lime</item>
        <item name="colorPrimaryContainer">@color/lime</item>
        <item name="colorOnPrimaryContainer">@color/text_on_lime</item>
        <item name="colorSecondary">@color/lime</item>
        <item name="colorOnSecondary">@color/text_on_lime</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="materialButtonStyle">@style/Widget.UsbBoost.Button</item>
    </style>

    <style name="Widget.UsbBoost.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.UsbBoost.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/stroke</item>
    </style>

    <style name="Widget.UsbBoost.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:checkable">true</item>
    </style>
</resources>
